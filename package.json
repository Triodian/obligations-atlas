{
  "name": "obligations-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "AI Obligations Atlas: AI governance obligations by jurisdiction, mapped to standardised AI use cases and tagged by source tier. Web app, REST API and MCP server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-metamodel": "node scripts/sync-metamodel.mjs ../triodian_metamodel",
    "seed:build": "node data/seed/build-seed.mjs",
    "data:check": "node scripts/check-data.mjs",
    "dev": "node src/node.js",
    "start": "node src/node.js",
    "test": "node --test test/*.test.js",
    "deploy": "wrangler deploy",
    "build": "node scripts/build.mjs",
    "prestart": "node scripts/build.mjs",
    "predev": "node scripts/build.mjs",
    "predeploy": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "wrangler": "^4.40.0"
  }
}
