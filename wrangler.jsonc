// Cloudflare Workers deployment for the AI Obligations Atlas.
// public/ is served as static assets; /api/*, /mcp and /healthz run in src/worker.js.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obligations-atlas",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Pull request preview builds run `npx wrangler preview`, which needs this block (it can be empty).
  "previews": {},
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/healthz"]
  },
  "vars": {
    // Hosts that show the preview data (records still waiting for review, with a banner).
    // Every other host shows published records only.
    "ATLAS_PREVIEW_HOSTS": "obligations-atlas-test.triodian.com",
    "ATLAS_PREVIEW": "false",
    // Where published records are read from when the FABRIC_READ_TOKEN secret is set.
    "FABRIC_URL": "https://uat.api.orthogramic.com/governance/v1",
    "ATLAS_CACHE_SECONDS": "300",
    "ATLAS_REQUIRE_KEY": "false",
    // The jurisdiction and regulated domain the register and matter brief start in (users can change both).
    // The installer sets them for a client; the demo starts in Australia with no domain.
    "DEFAULT_JURISDICTION": "AU",
    "DEFAULT_DOMAIN": ""
  }
  // Custom domains obligations-atlas.triodian.com and obligations-atlas-test.triodian.com are
  // attached in the dashboard (Settings -> Domains & Routes).
  // Secrets (Settings -> Variables and Secrets, or `wrangler secret put`):
  //   FABRIC_READ_TOKEN  read-only governance token; turns on live published data
  //   ATLAS_API_KEYS     JSON [{ "firm", "keySha256", "perMinute" }]
}
